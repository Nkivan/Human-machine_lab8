{
  "name": "dogfight",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "bench": "npm run bench -w shared",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "perf:client": "tsx tools/perf-client.ts",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "~4.0.18",
    "eslint": "^9.0.0",
    "fast-check": "^4.3.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "~4.0.18"
  }
}
