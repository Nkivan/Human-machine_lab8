{
  "name": "dogfight-server",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "start:native": "node --experimental-strip-types --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "replay": "tsx tools/replay-cli.ts",
    "profile:match": "tsx tools/profile-match.ts",
    "loadtest": "tsx tools/loadtest.ts"
  },
  "dependencies": {
    "@dogfight/shared": "*",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0"
  }
}
